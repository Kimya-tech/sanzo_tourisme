# Copier ce fichier en .env.local et renseigner les valeurs.
# En local : valeurs affichées par « npx supabase status ».
# Sur Vercel : Project Settings > Environment Variables (Preview et Production séparément).

VITE_SUPABASE_URL=https://votre-projet.supabase.co
# Clé publique (« publishable », sb_publishable_…). L'ancienne clé « anon » est aussi acceptée
# via VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_votre-cle-publique

# Facultatif : fond de carte (OpenStreetMap par défaut).
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; contributeurs OpenStreetMap

# Facultatif : vue satellite (Esri World Imagery par défaut, noms de lieux superposés).
# VITE_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# VITE_SATELLITE_LABELS_URL=   (vide = pas de noms de lieux)
# VITE_SATELLITE_ATTRIBUTION=Imagerie &copy; Esri

# INTERDIT : ne jamais ajouter ici la clé service_role / secrète (sb_secret_…).
# La compilation échoue si une telle clé est détectée dans une variable VITE_.
