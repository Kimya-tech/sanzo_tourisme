-- Fonctions d'aide communes aux tests pgTAP.
-- Incluses au début de chaque fichier de test via \ir (transactions annulées : rien n'est conservé).

create extension if not exists pgtap with schema extensions;

create schema if not exists tests;
grant usage on schema tests to anon, authenticated;

-- Crée un utilisateur Auth anonyme (comme supabase.auth.signInAnonymously()).
create or replace function tests.create_anonymous_user()
returns uuid
language plpgsql
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (instance_id, id, aud, role, is_anonymous, raw_user_meta_data, raw_app_meta_data)
  values ('00000000-0000-0000-0000-000000000000', v_id, 'authenticated', 'authenticated', true, '{}'::jsonb, '{}'::jsonb);
  return v_id;
end;
$$;

-- Crée directement un collecteur actif (sans passer par le code d'accès).
create or replace function tests.create_collector(p_name text)
returns uuid
language plpgsql
as $$
declare
  v_id uuid := tests.create_anonymous_user();
begin
  insert into public.collectors (user_id, invite_id, display_name)
  select v_id, i.id, p_name from private.collect_invites i where i.label = 'Test';
  return v_id;
end;
$$;

-- Simule une requête API authentifiée (appeler en tant que postgres ; « reset role » pour revenir).
create or replace function tests.authenticate_as(p_user uuid)
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims',
    json_build_object('sub', p_user, 'role', 'authenticated', 'is_anonymous', true)::text, true);
  execute 'set local role authenticated';
end;
$$;

create or replace function tests.authenticate_as_anon()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
  execute 'set local role anon';
end;
$$;

grant execute on all functions in schema tests to anon, authenticated;

-- Lien de collecte propre aux tests.
select private.create_collect_invite('Test', 'CODE-DE-TEST-123');
